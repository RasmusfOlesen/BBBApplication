{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug BBB Application",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bbb_application",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "miDebuggerServerAddress": "192.168.137.2:2345",
            "targetArchitecture": "arm",
            "stopAtEntry": true,
            "preLaunchTask": "Build Deploy and Start GDB Server",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}